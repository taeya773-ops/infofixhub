# Required: PostgreSQL connection string used by Prisma.
DATABASE_URL=

# Required: Public base URL for sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=

# Legacy seed fields only; these no longer grant administrator access.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required: random secret of at least 32 characters. Changing it logs out users.
AUTH_SECRET=
# Only this Google-verified email may administer the site. Empty = no admins.
ADMIN_GOOGLE_EMAIL=

# Optional: end-user social login. Add these in Render before enabling buttons.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# Optional: AI content generation provider. The app boots without these.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SCREENSHOTONE_ACCESS_KEY=

# Optional: keyword, SERP, trends, ads, and Search Console providers.
KEYWORD_PROVIDER=
KEYWORD_PROVIDER_API_KEY=
SERP_PROVIDER=
SERP_PROVIDER_API_KEY=
GOOGLE_TRENDS_ENABLED=
GOOGLE_ADS_ENABLED=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_SEARCH_CONSOLE_ENABLED=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional: provider behavior tuning.
SERP_CACHE_TTL=
PROVIDER_TIMEOUT_MS=
