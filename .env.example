# Required: PostgreSQL connection string used by Prisma.
DATABASE_URL=

# Required: Public base URL for sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=

# Required for the basic admin account created by prisma/seed.ts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Optional: AI content generation provider. The app boots without these.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
SCREENSHOTONE_ACCESS_KEY=

# Optional: keyword, SERP, trends, ads, and Search Console providers.
KEYWORD_PROVIDER=
KEYWORD_PROVIDER_API_KEY=
SERP_PROVIDER=
SERP_PROVIDER_API_KEY=
GOOGLE_TRENDS_ENABLED=
GOOGLE_ADS_ENABLED=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_SEARCH_CONSOLE_ENABLED=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional: provider behavior tuning.
SERP_CACHE_TTL=
PROVIDER_TIMEOUT_MS=
